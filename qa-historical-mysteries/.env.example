# Variables read by docker-compose.yml (put them in a file named .env NEXT TO docker-compose.yml)
DB_PASSWORD=choose-a-strong-password
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=0                 # 1 when the site is served over HTTPS
# DOMAIN=example.org            # only for: docker compose --profile prod up -d
# Your secrets (Groq key, Gmail app password, SESSION_SECRET, ADMIN_EMAILS...) stay in projet-qa-llm/.env
